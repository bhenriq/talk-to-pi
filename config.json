{
  "stt": {
    "model": "mistralai/voxtral-small-24b-2507",
    "sampleRate": 16000,
    "channels": 1,
    "bits": 16
  },
  "tts": {
    "provider": "openrouter",
    "command": "say",
    "sayVoice": "auto",
    "voice": "rachel",
    "speed": 1,
    "model": "elevenlabs/eleven-flash-v2.5",
    "format": "mp3"
  },
  "input": {
    "key": "space",
    "listenShortcut": "ctrl+shift+l",
    "talkShortcut": "ctrl+shift+t",
    "conferenceShortcut": "ctrl+shift+c",
    "voiceShortcut": "ctrl+shift+o",
    "micDevice": "MacBook Pro Microphone",
    "keyCode": 49,
    "pollMs": 25,
    "repeatSilenceMs": 150,
    "debounceMs": 250,
    "minRecordingMs": 400
  },
  "promptNudge": true,
  "audio": {
    "processingCue": true,
    "volume": 0.4,
    "intervalMs": 650,
    "headsetDevice": "OpenSwim Pro by Shokz",
    "localSpeaker": "MacBook Pro Speakers"
  },
  "listen": {
    "model": "deepgram/nova-3",
    "sampleRate": 16000,
    "channels": 1,
    "bits": 16,
    "chunkSeconds": 5,
    "skipSilence": true,
    "silenceThreshold": 0.005,
    "outputDir": "~/.pi/listen",
    "contextWindowChars": 6000,
    "widgetLines": 8,
    "contextMode": "summary",
    "summaryModel": "deepseek/deepseek-chat"
  },
  "say": {
    "mode": "approval"
  },
  "conference": {
    "roomDevice": "BlackHole 2ch",
    "remoteTapDevice": "BlackHole 16ch",
    "relayMic": true,
    "micGain": 1,
    "ttsGain": 1,
    "remoteTap": true,
    "muteBusyCue": false,
    "systemInputDevice": "BlackHole 2ch",
    "switchSystemDevices": true,
    "headset": {
      "voiceDevice": "Pi Talks (headset)",
      "systemOutputDevice": "Pi Listens (headset)"
    },
    "builtin": {
      "voiceDevice": "Pi Talks (speaker)",
      "systemOutputDevice": "Pi Listens (speaker)"
    }
  }
}
